# Chronicle Blog Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Cloud Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/chronicle_blog?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:secure_password@cluster0.mongodb.net/chronicle_blog?retryWrites=true&w=majority

# JWT Signing Secret
JWT_SECRET=chronicle_production_jwt_secret_token_2026_super_secure

# Administrator Seed Credentials (Used only on initial setup)
ADMIN_EMAIL=admin@chronicle.com
ADMIN_PASSWORD=Admin@123456
